# ==============================================================================
# VARIÁVEIS DE AMBIENTE - PROJETO GESTÃO DE PACIENTES
# ==============================================================================
# Copie este arquivo como .env.local para executar localmente:
#   cp .env.example .env.local
# Nunca comite chaves secretas (service_role, senhas) no controle de versão.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI STUDIO & AMBIENTE DA APLICAÇÃO
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Injetado automaticamente pelo Google AI Studio em tempo de execução.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base pública da aplicação (injetada no Cloud Run / Vercel).
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 2. SUPABASE - API & CLIENT SDK (@supabase/supabase-js)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard -> Project Settings -> API

# URL da instância do seu projeto Supabase (pública para Client e Server)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Chave pública anônima (safe para browser com RLS ativado)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here"

# Chave secreta administrativa Service Role (USO EXCLUSIVO NO SERVIDOR)
# Utilizada em Server Actions para operações com permissão de sistema
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here"

# Segredo JWT do Supabase / Aplicação para validação de sessões de usuário
SUPABASE_JWT_SECRET="your-jwt-secret-string"
AUTH_SECRET="your-secure-jwt-session-secret-key-at-least-32-chars-long"

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL - STRINGS DE CONEXÃO DIRETA (CLI, Prisma, Drizzle ou psql)
# ------------------------------------------------------------------------------
# Obtenha em: Supabase Dashboard -> Project Settings -> Database -> Connection string

# String de conexão com Pooling (PgBouncer - porta 6543) ideal para Serverless
DATABASE_URL="postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# String de conexão direta (porta 5432) para executar scripts DDL, migrations e triggers
DIRECT_URL="postgresql://postgres.your-project-id:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 4. GOOGLE CALENDAR API (v3) - GOOGLE SERVICE ACCOUNT (SERVER-SIDE OFICIAL)
# ------------------------------------------------------------------------------
# Para que os agendamentos sejam criados diretamente na agenda da Dra. Juliana Sena:
#
# PASSO A PASSO NO GOOGLE CLOUD:
# 1. Ative a 'Google Calendar API' no Google Cloud Console.
# 2. Em 'IAM e administração' -> 'Contas de serviço' (Service Accounts), crie uma Service Account.
# 3. Na aba 'Chaves', adicione uma nova chave do tipo JSON.
# 4. No Google Calendar da Dra. Juliana (calendar.google.com):
#    - Vá em 'Configurações da agenda' -> 'Compartilhar com pessoas específicas'.
#    - Adicione o e-mail da Service Account (ex: gestao-pacientes@projeto.iam.gserviceaccount.com).
#    - Dê a permissão: "Fazer alterações nos eventos" (Make changes to events).
#    - Copie o 'ID da agenda' (geralmente o e-mail da médica ou id@group.calendar.google.com).

# E-mail da Service Account (ex: service-account-name@project-id.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"

# Chave privada da Service Account (formato PEM com BEGIN/END PRIVATE KEY).
# Quebras de linha literais '\n' são tratadas e sanitizadas automaticamente pelo sistema.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ID da agenda no Google Calendar onde os eventos serão criados
# (ex: juliana.sena@gmail.com ou id-da-agenda@group.calendar.google.com ou primary)
GOOGLE_CALENDAR_ID="juliana.sena@gmail.com"

# Compatibilidade legada / consulta pública opcional
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_API_KEY="your-google-api-key"
